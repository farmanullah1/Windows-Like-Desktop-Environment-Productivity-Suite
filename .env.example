# ==============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# DO NOT COMMIT ACTUAL SECRETS OR SENSITIVE PASSWORDS TO SOURCE CONTROL
# ==============================================================================

# Application Environment
NODE_ENV=development
APP_PORT=3000
API_PORT=5000

# Server API Configuration
API_URL=http://localhost:5000/api/v1
SESSION_SECRET=change-this-to-a-secure-random-64-char-string-in-production
JWT_SECRET=change-this-to-a-secure-jwt-secret-in-production
JWT_EXPIRES_IN=7d

# Database Configuration (Microsoft SQL Server)
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=WindowsDesktopSuiteDB
DB_USER=sa
DB_PASSWORD=your_secure_password_here
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true

# Native Windows Integration Bridge
ENABLE_NATIVE_BRIDGE=true
WINDOWS_BRIDGE_PORT=5050
NATIVE_COMMAND_TIMEOUT_MS=10000

# Performance & Visual Modes
DEFAULT_EFFECTS_MODE=balanced
ENABLE_HARDWARE_ACCELERATION=true
ENABLE_WEB_AUDIO_SOUNDS=true

# Audit & Logging
LOG_LEVEL=info
ENABLE_AUDIT_LOGGING=true
